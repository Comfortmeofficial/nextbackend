# One DATABASE_URL per migrated domain, mirroring the per-service databases
# in the legacy platform (services/<name>/.env.example). Add a new
# <DOMAIN>_DATABASE_URL as each additional service is strangled into this app.

TERMS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comfort_me
USER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comfort_me
CARD_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comfort_me
REWARD_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comfort_me
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comfort_me

# auth module — must match whatever secret the legacy auth_service uses in prod.
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=refresh_change_me_in_production

DRIVER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comfort_me
# Verifies driver-portal access tokens — used by both the drivers module's
# own /me endpoint and the booking module's separate driver-auth guard.
# Only matters for cross-service sync if some other still-unmigrated service
# ever needs to verify these tokens too; nothing currently does.
DRIVER_JWT_SECRET=change_me_in_production

BUS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comfort_me

WALLET_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comfort_me

# notifications module — DATABASE_URL is optional here (unlike every other
# module): if unset, sends still go out but nothing is persisted to an
# inbox, matching the source's degraded-mode design.
NOTIFICATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comfort_me
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@comfortmeng.com
RESEND_FROM_NAME=Comfort Me

BOOKING_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comfort_me
# Optional — only /rides/{id}/eta needs this. That endpoint 502s with a clear
# message if it's unset, same as the source.
GOOGLE_MAPS_API_KEY=

# payments module — stateless, no database. Every endpoint 500s with
# "Payment gateway not configured" if this is unset.
PAYSTACK_SECRET_KEY=

ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comfort_me
ADMIN_JWT_SECRET=change_me_in_production
# One-time /api/v1/admin/auth/setup bootstrap — seeds the super admin.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# Orphaned services — no APISIX route / no UI caller in the legacy platform,
# ported anyway per explicit instruction.
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comfort_me
SUBSCRIPTION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comfort_me

# payment-hub module — no config of its own. It's a stateless orchestrator
# that only calls the modules above in-process (wallet, cards, booking,
# notifications, rewards, users, payments), so it just needs their env vars
# already set, most importantly PAYSTACK_SECRET_KEY for any non-wallet
# payment method.
